{
  "name": "codex-desktop",
  "version": "1.0.0",
  "description": "Minimal Codex desktop wrapper",
  "main": "build/main/main.js",
  "scripts": {
    "prestart": "npm run build:main",
    "dev:main": "tsc -w --preserveWatchOutput",
    "dev:renderer": "vite --config vite.config.ts",
    "dev:electron": "wait-on tcp:5173 && electron .",
    "start": "concurrently -k -p '[{name}]' -n MAIN,RENDERER,ELECTRON -c cyan,magenta,green \"npm:dev:main\" \"npm:dev:renderer\" \"npm:dev:electron\"",
    "build:main": "tsc -p .",
    "build:renderer": "vite build --config vite.config.ts",
    "build": "npm run build:mac",
    "build:mac": "npm run build:main && npm run build:renderer && electron-builder --mac",
    "build:mac:signed": "npm run build:main && npm run build:renderer && CSC_IDENTITY_AUTO_DISCOVERY=true electron-builder --mac",
    "build:win": "npm run build:main && npm run build:renderer && electron-builder --win --x64",
    "build:linux": "npm run build:main && npm run build:renderer && electron-builder --linux",
    "test": "playwright test"
  },
  "keywords": [],
  "author": {
    "name": "Codex Desktop Team",
    "email": "support@codex.local"
  },
  "homepage": "https://codex.local/desktop",
  "license": "ISC",
  "dependencies": {
    "@openai/codex-sdk": "^0.46.0",
    "dotenv": "^17.2.3",
    "toml": "^3.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/node": "^24.7.2",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^8.2.2",
    "electron": "^38.2.2",
    "electron-builder": "^26.0.12",
    "playwright": "^1.56.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "typescript": "^5.9.3",
    "vite": "^5.4.10",
    "wait-on": "^7.0.1"
  }
}
